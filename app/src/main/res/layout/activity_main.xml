<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp"
    android:background="@color/background_light">

    <!-- Header -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Music Service"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@color/primary"
        android:layout_marginBottom="24dp" />

    <!-- Status Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/border_color"
        android:layout_marginBottom="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:gravity="center"
            android:background="@color/white">

            <TextView
                android:id="@+id/tvServiceStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="● Service Stopped"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/accent_red" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Controls -->
    <Button
        android:id="@+id/btnStart"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Start Service"
        android:textSize="16sp"
        android:textStyle="bold"
        android:backgroundTint="@color/primary"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnStop"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Stop Service"
        android:textSize="16sp"
        android:textStyle="bold"
        android:backgroundTint="@color/accent_red"
        android:layout_marginBottom="24dp" />

    <!-- Navigation -->
    <Button
        android:id="@+id/btnNavTrackSelector"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:text="Select Track"
        android:textSize="15sp"
        android:backgroundTint="@color/secondary"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnNavAbout"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:text="About"
        android:textSize="15sp"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:textColor="@color/primary"
        app:strokeColor="@color/primary" />

</LinearLayout>
